# =============================================
# DevOrbit - Comprehensive .gitignore
# =============================================

# ---------- Maven Build Output ----------
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
effective.xml

# ---------- Compiled Class Files ----------
*.class

# ---------- Log Files ----------
*.log
build_log.txt

# ---------- Package / Archive Files ----------
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ---------- JVM Crash Logs ----------
hs_err_pid*
replay_pid*

# ---------- IDE Settings ----------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Eclipse
.classpath
.project
.settings/
bin/

# NetBeans
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/
build/

# BlueJ
*.ctxt

# ---------- OS Generated Files ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump
[Dd]esktop.ini

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ---------- Environment / Secrets ----------
.env
.env.*
*.env
key.json
*-key.json
*-credentials.json
serviceAccountKey.json
firebase-adminsdk*.json
secrets/

# ---------- Java / Mobile Tools ----------
.mtj.tmp/

# ---------- Temp & Cache ----------
*.tmp
*.bak
*.swp
*.swo
*~
.cache/
tmp/
temp/

# ---------- Miscellaneous ----------
*.orig
*.rej
.gradle/
